pipeline {
    agent any
    options { disableConcurrentBuilds() }
    triggers { pollSCM('H/2 * * * *') }

    stages {
        stage('Test') {
            steps {
                dir('Assignment-3') {
                sh 'python3 -m venv .venv'
                sh '.venv/bin/pip install -r proxy/requirements.txt -r tests/requirements.txt'
                sh '.venv/bin/pytest -q'
                sh 'docker compose config --quiet'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('Assignment-3') {
                sh 'docker compose pull ai-service prometheus grafana cadvisor'
                sh 'docker compose up --build -d'
                }
            }
        }

        stage('Verify') {
            steps {
                dir('Assignment-3') {
                    sh '.venv/bin/python verify_deployment.py'
                }
            }
        }
    }
}
